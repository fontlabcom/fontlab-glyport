<?xml version="1.0" encoding="UTF-8"?>
<!-- this_file: tests/fixtures/nib/Formatters.xib
     Self-authored fixture: number formatters as cell formatters and as a
     standalone top-level object, with set and unset limits, and an owner outlet
     to a cell (no corpus content).
     Formatters.nib is its xcrun ibtool compile output. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="14460.31" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="14460.31"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="FormatOwner">
            <connections>
                <outlet property="dialog" destination="root" id="o-1"/>
                <outlet property="spare" destination="fmt" id="o-2"/>
                <outlet property="limitCell" destination="lim-cell" id="o-3"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="root">
            <rect key="frame" x="0.0" y="0.0" width="200" height="60"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <textField verticalHuggingPriority="750" id="lim">
                    <rect key="frame" x="10" y="30" width="80" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" borderStyle="bezel" title="5" drawsBackground="YES" id="lim-cell">
                        <numberFormatter key="formatter" formatterBehavior="default10_4" numberStyle="decimal" id="lim-fmt">
                            <real key="minimum" value="2"/>
                            <real key="maximum" value="12.5"/>
                        </numberFormatter>
                        <font key="font" metaFont="system"/>
                    </textFieldCell>
                </textField>
                <textField verticalHuggingPriority="750" id="free">
                    <rect key="frame" x="100" y="30" width="80" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" borderStyle="bezel" title="1" drawsBackground="YES" id="free-cell">
                        <numberFormatter key="formatter" formatterBehavior="default10_4" numberStyle="decimal" id="free-fmt"/>
                        <font key="font" metaFont="system"/>
                    </textFieldCell>
                </textField>
            </subviews>
        </customView>
        <numberFormatter formatterBehavior="default10_4" numberStyle="decimal" id="fmt">
            <real key="minimum" value="-3"/>
        </numberFormatter>
    </objects>
</document>
