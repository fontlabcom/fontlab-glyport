<?xml version="1.0" encoding="UTF-8"?>
<!-- this_file: tests/fixtures/nib/Segments.xib
     Self-authored fixture: a select-one segmented control with an action, a
     select-any one, and a search field with a placeholder sending its string
     immediately (no corpus content). Segments.nib is its xcrun ibtool compile output. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="14460.31" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="14460.31"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="SegmentsOwner">
            <connections>
                <outlet property="dialog" destination="root" id="o-1"/>
                <outlet property="tabs" destination="seg" id="o-2"/>
                <outlet property="styles" destination="seg2" id="o-3"/>
                <outlet property="search" destination="sf" id="o-4"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="root">
            <rect key="frame" x="0.0" y="0.0" width="320" height="100"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <segmentedControl verticalHuggingPriority="750" id="seg">
                    <rect key="frame" x="18" y="60" width="210" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="rounded" trackingMode="selectOne" id="seg-cell">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="Left" width="100"/>
                            <segment label="Right" width="100" selected="YES" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="pickTab:" target="-2" id="a-1"/>
                    </connections>
                </segmentedControl>
                <segmentedControl verticalHuggingPriority="750" id="seg2">
                    <rect key="frame" x="18" y="30" width="160" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="rounded" trackingMode="selectAny" id="seg2-cell">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="B" width="50" selected="YES"/>
                            <segment label="I" width="50"/>
                            <segment label="U" width="50" selected="YES"/>
                        </segments>
                    </segmentedCell>
                </segmentedControl>
                <searchField wantsLayer="YES" verticalHuggingPriority="750" textCompletion="NO" id="sf">
                    <rect key="frame" x="20" y="5" width="200" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <searchFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" placeholderString="Search Groups" usesSingleLineMode="YES" bezelStyle="round" sendsSearchStringImmediately="YES" id="sf-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </searchFieldCell>
                    <connections>
                        <action selector="searched:" target="-2" id="a-2"/>
                    </connections>
                </searchField>
            </subviews>
        </customView>
    </objects>
</document>
