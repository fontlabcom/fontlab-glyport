<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="14460.31" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="14460.31"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="DemoFilter">
            <connections>
                <outlet property="dialog" destination="1" id="o-1"/>
                <outlet property="widthField" destination="w-f" id="o-2"/>
                <outlet property="keepCheckbox" destination="k-c" id="o-3"/>
                <outlet property="angleSlider" destination="a-s" id="o-4"/>
                <outlet property="modePopup" destination="m-p" id="o-5"/>
                <outlet property="titleLabel" destination="t-l" id="o-6"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="1" customClass="GSPaletteView">
            <rect key="frame" x="0.0" y="0.0" width="240" height="150"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <textField verticalHuggingPriority="750" id="t-l">
                    <rect key="frame" x="18" y="113" width="80" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" sendsActionOnEndEditing="YES" title="Width" id="t-l-c">
                        <font key="font" metaFont="system"/>
                    </textFieldCell>
                </textField>
                <textField toolTip="Width in units" verticalHuggingPriority="750" id="w-f" customClass="GSSteppingTextField">
                    <rect key="frame" x="104" y="110" width="116" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" continuous="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" title="12" drawsBackground="YES" id="w-f-c">
                        <font key="font" metaFont="system"/>
                    </textFieldCell>
                    <connections>
                        <action selector="setWidth:" target="-2" id="a-1"/>
                        <binding destination="udc" name="value" keyPath="values.com.glyport.demo.width" id="b-1"/>
                    </connections>
                </textField>
                <button verticalHuggingPriority="750" id="k-c">
                    <rect key="frame" x="18" y="84" width="204" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Keep original" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="k-c-c">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="toggleKeep:" target="-2" id="a-2"/>
                    </connections>
                </button>
                <slider verticalHuggingPriority="750" id="a-s">
                    <rect key="frame" x="18" y="56" width="204" height="20"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <sliderCell key="cell" continuous="YES" state="on" alignment="left" minValue="-45" maxValue="45" doubleValue="15" tickMarkPosition="above" sliderType="linear" id="a-s-c"/>
                    <connections>
                        <action selector="setAngle:" target="-2" id="a-3"/>
                    </connections>
                </slider>
                <popUpButton verticalHuggingPriority="750" id="m-p">
                    <rect key="frame" x="16" y="16" width="120" height="26"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <popUpButtonCell key="cell" type="push" title="Outline" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="m-1" id="m-p-c">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="menu"/>
                        <menu key="menu" id="m-p-m">
                            <items>
                                <menuItem title="Fill" id="m-0"/>
                                <menuItem title="Outline" state="on" id="m-1"/>
                                <menuItem title="Both" id="m-2"/>
                            </items>
                        </menu>
                    </popUpButtonCell>
                    <connections>
                        <action selector="setMode:" target="-2" id="a-4"/>
                    </connections>
                </popUpButton>
                <button verticalHuggingPriority="750" id="ap">
                    <rect key="frame" x="146" y="10" width="80" height="32"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                    <buttonCell key="cell" type="push" title="Apply" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="ap-c">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="apply:" target="-2" id="a-5"/>
                    </connections>
                </button>
            </subviews>
        </customView>
        <userDefaultsController representsSharedInstance="YES" id="udc"/>
    </objects>
</document>
