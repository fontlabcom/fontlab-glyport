<?xml version="1.0" encoding="UTF-8"?>
<!-- this_file: tests/fixtures/nib/Stack.xib
     Self-authored fixture: a vertical stack view (edge insets, leading
     alignment) and a horizontal one nested in it (no corpus content).
     Stack.nib is its xcrun ibtool compile output. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="14460.31" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="14460.31"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="StackOwner">
            <connections>
                <outlet property="dialog" destination="root" id="o-1"/>
                <outlet property="column" destination="col" id="o-2"/>
                <outlet property="row" destination="row" id="o-3"/>
                <outlet property="titleLabel" destination="lbl" id="o-4"/>
                <outlet property="optionBox" destination="chk" id="o-5"/>
                <outlet property="okButton" destination="ok" id="o-6"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="root">
            <rect key="frame" x="0.0" y="0.0" width="220" height="140"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <stackView distribution="fill" orientation="vertical" alignment="leading" spacing="8" horizontalStackHuggingPriority="249.99998474121094" verticalStackHuggingPriority="249.99998474121094" detachesHiddenViews="YES" translatesAutoresizingMaskIntoConstraints="NO" id="col">
                    <rect key="frame" x="0.0" y="0.0" width="220" height="140"/>
                    <edgeInsets key="edgeInsets" left="10" right="10" top="10" bottom="10"/>
                    <subviews>
                        <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="lbl">
                            <rect key="frame" x="8" y="114" width="60" height="16"/>
                            <textFieldCell key="cell" lineBreakMode="clipping" title="Options" id="lbl-cell">
                                <font key="font" metaFont="system"/>
                            </textFieldCell>
                        </textField>
                        <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="chk">
                            <rect key="frame" x="8" y="89" width="100" height="18"/>
                            <buttonCell key="cell" type="check" title="Keep" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="chk-cell">
                                <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                <font key="font" metaFont="system"/>
                            </buttonCell>
                        </button>
                        <stackView distribution="fill" orientation="horizontal" alignment="top" spacing="6" horizontalStackHuggingPriority="249.99998474121094" verticalStackHuggingPriority="249.99998474121094" detachesHiddenViews="YES" translatesAutoresizingMaskIntoConstraints="NO" id="row">
                            <rect key="frame" x="10" y="10" width="160" height="32"/>
                            <subviews>
                                <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="cancel">
                                    <rect key="frame" x="-6" y="-2" width="82" height="32"/>
                                    <buttonCell key="cell" type="push" title="Cancel" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="cancel-cell">
                                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                </button>
                                <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="ok">
                                    <rect key="frame" x="76" y="-2" width="82" height="32"/>
                                    <buttonCell key="cell" type="push" title="OK" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="ok-cell">
                                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                </button>
                            </subviews>
                        </stackView>
                    </subviews>
                </stackView>
            </subviews>
        </customView>
    </objects>
</document>
