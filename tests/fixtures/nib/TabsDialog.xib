<?xml version="1.0" encoding="UTF-8"?>
<!-- this_file: tests/fixtures/nib/TabsDialog.xib
     Self-authored fixture: tab view pages, number formatter, progress bar and
     Auto Layout constraints (no corpus content). TabsDialog.nib is its xcrun ibtool compile output. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="14460.31" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="14460.31"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="TabsOwner">
            <connections>
                <outlet property="dialog" destination="root" id="o-1"/>
                <outlet property="amountField" destination="amt" id="o-2"/>
                <outlet property="deepCheckbox" destination="chk" id="o-3"/>
                <outlet property="sourcePopup" destination="pop" id="o-4"/>
                <outlet property="progressBar" destination="bar" id="o-5"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView translatesAutoresizingMaskIntoConstraints="NO" id="root" customClass="GSPaletteView">
            <rect key="frame" x="0.0" y="0.0" width="260" height="120"/>
            <subviews>
                <tabView translatesAutoresizingMaskIntoConstraints="NO" id="tabs">
                    <rect key="frame" x="-7" y="-10" width="274" height="126"/>
                    <font key="font" metaFont="system"/>
                    <tabViewItems>
                        <tabViewItem label="first" identifier="one" id="item-1">
                            <view key="view" id="page-1">
                                <rect key="frame" x="10" y="33" width="254" height="80"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <textField verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="amt">
                                        <rect key="frame" x="8" y="50" width="60" height="21"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="60" id="c-w"/>
                                        </constraints>
                                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" title="3" drawsBackground="YES" id="amt-c">
                                            <numberFormatter key="formatter" formatterBehavior="default10_4" usesGroupingSeparator="NO" groupingSize="0" minimumIntegerDigits="1" maximumIntegerDigits="42" id="fmt">
                                                <real key="minimum" value="0.0"/>
                                                <real key="maximum" value="20"/>
                                            </numberFormatter>
                                            <font key="font" metaFont="system"/>
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                        </textFieldCell>
                                    </textField>
                                    <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="chk">
                                        <rect key="frame" x="6" y="14" width="120" height="18"/>
                                        <buttonCell key="cell" type="check" title="Deep" bezelStyle="regularSquare" imagePosition="left" inset="2" id="chk-c">
                                            <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                            <font key="font" metaFont="system"/>
                                        </buttonCell>
                                        <connections>
                                            <action selector="toggleDeep:" target="-2" id="a-1"/>
                                        </connections>
                                    </button>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="amt" firstAttribute="leading" secondItem="page-1" secondAttribute="leading" constant="8" id="c-1"/>
                                    <constraint firstItem="amt" firstAttribute="top" secondItem="page-1" secondAttribute="top" constant="9" id="c-2"/>
                                    <constraint firstItem="chk" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="page-1" secondAttribute="leading" constant="8" id="c-3"/>
                                    <constraint firstItem="chk" firstAttribute="top" secondItem="amt" secondAttribute="bottom" constant="20" id="c-4"/>
                                    <constraint firstItem="chk" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="amt" secondAttribute="leading" constant="8" symbolic="YES" id="c-10"/>
                                </constraints>
                            </view>
                        </tabViewItem>
                        <tabViewItem label="second" identifier="two" id="item-2">
                            <view key="view" id="page-2">
                                <rect key="frame" x="10" y="33" width="254" height="80"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <popUpButton verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="pop">
                                        <rect key="frame" x="6" y="44" width="120" height="26"/>
                                        <popUpButtonCell key="cell" type="push" title="Local" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="p-1" id="pop-c">
                                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                                            <font key="font" metaFont="menu"/>
                                            <menu key="menu" id="pop-m">
                                                <items>
                                                    <menuItem title="Bundled" id="p-0"/>
                                                    <menuItem title="Local" state="on" id="p-1"/>
                                                </items>
                                            </menu>
                                        </popUpButtonCell>
                                        <connections>
                                            <action selector="chooseSource:" target="-2" id="a-2"/>
                                        </connections>
                                    </popUpButton>
                                    <textField verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="note">
                                        <rect key="frame" x="134" y="48" width="118" height="28"/>
                                        <textFieldCell key="cell" controlSize="small" sendsActionOnEndEditing="YES" id="note-c">
                                            <font key="font" metaFont="smallSystem"/>
                                            <string key="title">A long note
on two lines</string>
                                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                        </textFieldCell>
                                    </textField>
                                    <progressIndicator maxValue="100" doubleValue="25" style="bar" translatesAutoresizingMaskIntoConstraints="NO" id="bar">
                                        <rect key="frame" x="8" y="12" width="238" height="20"/>
                                    </progressIndicator>
                                </subviews>
                                <constraints>
                                    <constraint firstAttribute="trailing" secondItem="bar" secondAttribute="trailing" constant="8" id="c-5"/>
                                    <constraint firstItem="bar" firstAttribute="leading" secondItem="page-2" secondAttribute="leading" constant="8" id="c-6"/>
                                    <constraint firstItem="pop" firstAttribute="centerX" secondItem="bar" secondAttribute="centerX" multiplier="0.5" constant="4" id="c-7"/>
                                </constraints>
                            </view>
                        </tabViewItem>
                    </tabViewItems>
                </tabView>
            </subviews>
            <constraints>
                <constraint firstItem="tabs" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="c-8"/>
                <constraint firstAttribute="bottom" secondItem="tabs" secondAttribute="bottom" priority="750" id="c-9"/>
            </constraints>
        </customView>
    </objects>
</document>
