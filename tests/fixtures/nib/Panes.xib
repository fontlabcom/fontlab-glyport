<?xml version="1.0" encoding="UTF-8"?>
<!-- this_file: tests/fixtures/nib/Panes.xib
     Self-authored fixture: a vertical-divider split view with two panes, a
     2x2 grid view of labels and a visual effect view holding a label (no
     corpus content). Panes.nib is its xcrun ibtool compile output. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="14460.31" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="14460.31"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PanesOwner">
            <connections>
                <outlet property="dialog" destination="root" id="o-1"/>
                <outlet property="split" destination="sp" id="o-2"/>
                <outlet property="leftPane" destination="left" id="o-3"/>
                <outlet property="grid" destination="gr" id="o-4"/>
                <outlet property="effect" destination="fx" id="o-5"/>
                <outlet property="cornerLabel" destination="l4" id="o-6"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView translatesAutoresizingMaskIntoConstraints="NO" id="root">
            <rect key="frame" x="0.0" y="0.0" width="400" height="200"/>
            <subviews>
                <splitView arrangesAllSubviews="NO" dividerStyle="thin" vertical="YES" translatesAutoresizingMaskIntoConstraints="NO" id="sp">
                    <rect key="frame" x="0.0" y="100" width="400" height="100"/>
                    <subviews>
                        <customView id="left">
                            <rect key="frame" x="0.0" y="0.0" width="150" height="100"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </customView>
                        <customView id="right">
                            <rect key="frame" x="151" y="0.0" width="249" height="100"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </customView>
                    </subviews>
                    <holdingPriorities>
                        <real value="250"/>
                        <real value="250"/>
                    </holdingPriorities>
                </splitView>
                <gridView xPlacement="leading" yPlacement="center" rowAlignment="none" rowSpacing="6" columnSpacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="gr">
                    <rect key="frame" x="10" y="10" width="180" height="40"/>
                    <rows>
                        <gridRow id="r1"/>
                        <gridRow id="r2"/>
                    </rows>
                    <columns>
                        <gridColumn id="c1"/>
                        <gridColumn id="c2"/>
                    </columns>
                    <gridCells>
                        <gridCell row="r1" column="c1" id="g1">
                            <textField key="contentView" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="l1">
                                <rect key="frame" x="-2" y="24" width="40" height="16"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" title="One" id="l1-cell">
                                    <font key="font" metaFont="system"/>
                                </textFieldCell>
                            </textField>
                        </gridCell>
                        <gridCell row="r1" column="c2" id="g2">
                            <textField key="contentView" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="l2">
                                <rect key="frame" x="44" y="24" width="40" height="16"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" title="Two" id="l2-cell">
                                    <font key="font" metaFont="system"/>
                                </textFieldCell>
                            </textField>
                        </gridCell>
                        <gridCell row="r2" column="c1" id="g3">
                            <textField key="contentView" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="l3">
                                <rect key="frame" x="-2" y="0.0" width="40" height="16"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" title="Three" id="l3-cell">
                                    <font key="font" metaFont="system"/>
                                </textFieldCell>
                            </textField>
                        </gridCell>
                        <gridCell row="r2" column="c2" id="g4">
                            <textField key="contentView" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="l4">
                                <rect key="frame" x="44" y="0.0" width="40" height="16"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" title="Four" id="l4-cell">
                                    <font key="font" metaFont="system"/>
                                </textFieldCell>
                            </textField>
                        </gridCell>
                    </gridCells>
                </gridView>
                <visualEffectView blendingMode="behindWindow" material="sidebar" state="followsWindowActiveState" translatesAutoresizingMaskIntoConstraints="NO" id="fx">
                    <rect key="frame" x="200" y="10" width="190" height="80"/>
                    <subviews>
                        <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="fxl">
                            <rect key="frame" x="8" y="30" width="100" height="16"/>
                            <textFieldCell key="cell" lineBreakMode="clipping" title="Frosted" id="fxl-cell">
                                <font key="font" metaFont="system"/>
                            </textFieldCell>
                        </textField>
                    </subviews>
                </visualEffectView>
            </subviews>
        </customView>
    </objects>
</document>
